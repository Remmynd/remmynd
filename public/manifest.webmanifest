{
  "name": "remmynd",
  "short_name": "remmynd",
  "description": "Reminders that make sure it happens. Write it in one line and share the link. Anyone who taps it is reminded in layers and followed through. Free, no account needed, no tracking.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F5F6F7",
  "theme_color": "#0E0F11",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "/",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "categories": [
    "productivity",
    "utilities"
  ],
  "screenshots": [
    {
      "src": "screenshots/make-1080x1920.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Write a reminder in one line"
    },
    {
      "src": "screenshots/remind-1080x1920.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "One tap: calendar, phone alerts and follow-through"
    },
    {
      "src": "screenshots/wide-1920x1080.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "remmynd on a computer"
    }
  ],
  "shortcuts": [
    {
      "name": "New reminder",
      "url": "/",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
