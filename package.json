{
  "name": "remmynd",
  "version": "2.0.0",
  "description": "Reminders that make sure it happens. Turn any event into a link: anyone who taps it is reminded by calendar and phone alert. Zero dependencies.",
  "keywords": [
    "reminder",
    "calendar",
    "add-to-calendar",
    "ics",
    "icalendar",
    "google-calendar",
    "outlook",
    "event",
    "link",
    "badge",
    "cli"
  ],
  "homepage": "https://remmynd.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Remmynd/remmynd.git"
  },
  "bugs": {
    "url": "https://github.com/Remmynd/remmynd/issues"
  },
  "license": "MIT",
  "author": "Zoof04 Inc. (https://zoof04.com)",
  "type": "module",
  "main": "./lib/remmynd.js",
  "types": "./lib/remmynd.d.ts",
  "exports": {
    ".": {
      "types": "./lib/remmynd.d.ts",
      "default": "./lib/remmynd.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "remmynd": "bin/remmynd.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --import ./scripts/text-loader.mjs --test",
    "dev": "npx --yes wrangler@4 dev",
    "check": "npm test && npx --yes wrangler@4 deploy --dry-run --outdir .wrangler/check",
    "ship": "npm test && npx --yes wrangler@4 deploy",
    "deploy": "npx --yes wrangler@4 deploy",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "push:setup": "node scripts/push-setup.mjs"
  }
}
